# Copy to .env (gitignored). Everything is optional: with nothing set, Owed runs in
# demo mode (in-memory PayPal fake + deterministic demo model) and says so on screen.

# --- PayPal (sandbox only) -------------------------------------------------------
# developer.paypal.com > Apps & Credentials > Sandbox > your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: the webhook ID from the same app, to verify INVOICING.INVOICE.PAID events
PAYPAL_WEBHOOK_ID=

# --- LLM: any OpenAI-compatible /chat/completions endpoint -----------------------
# Examples: https://api.openai.com/v1 | https://api.groq.com/openai/v1 |
#           https://openrouter.ai/api/v1 | http://localhost:11434/v1 (Ollama)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=25000
# Gemini 3.x: minimal keeps thinking short (faster, no empty replies; "none" is refused by some models). Leave empty for others.
LLM_REASONING_EFFORT=

# --- You (appears on invoices and in reminder sign-offs) -------------------------
INVOICER_NAME=Sam Rivera
INVOICER_BUSINESS=Rivera Studio
# Must be the sandbox business account's email if set; leave empty to let PayPal use it
INVOICER_EMAIL=
DEFAULT_CURRENCY=USD

# --- Server -----------------------------------------------------------------------
PORT=3000
# HOST defaults to 127.0.0.1 locally and 0.0.0.0 on Render
# HOST=127.0.0.1
# How often to ask PayPal about open invoices and send due reminders (0 = off)
POLL_INTERVAL_SECONDS=60
RATE_LIMIT_PER_MINUTE=60
# Where the ledger is kept (JSON). OWED_PERSIST=0 keeps everything in memory.
# DATA_DIR=./data
# OWED_PERSIST=1
# Force demo mode even with keys set
# OWED_MOCK=1
