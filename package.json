{
  "name": "owed",
  "version": "1.0.0",
  "description": "Owed: an AI collections agent for freelancers. Paste a brief; it bills the client through PayPal invoicing, plans and sends reminders, notices payment and answers who owes you what.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch-path=src --watch-path=public src/server.js",
    "build": "node build.mjs",
    "postinstall": "node build.mjs",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@bryntum/scheduler": "npm:@bryntum/scheduler-trial@^7.3.7",
    "esbuild": "^0.28.2"
  }
}
